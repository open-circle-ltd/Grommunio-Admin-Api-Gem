# Live-test configuration. Export these variables explicitly before running
# the live specs — never commit real values.
#
# Read-only live verification (spec/live/v1_read_spec.rb):
GROMMUNIO_URL=https://mail.example.test:8443
GROMMUNIO_USERNAME=admin
GROMMUNIO_PASSWORD=changeme
GROMMUNIO_VERIFY_SSL=true
GROMMUNIO_LIVE_DOMAIN_ID=12
GROMMUNIO_LIVE_ORGANIZATION_ID=12

# Controlled live sync (spec/live/v1_sync_spec.rb) — requires ALL of these,
# plus a dedicated persistent LDAP test account that uniquely matches the
# query. The spec aborts before mutation unless exactly one candidate matches.
GROMMUNIO_LIVE_SYNC=1
GROMMUNIO_LIVE_LDAP_QUERY=test.user
GROMMUNIO_LIVE_EXPECTED_USERNAME=test.user@example.test

# Controlled live shared-mailbox creation (spec/live/v1_write_spec.rb). Use a
# non-production instance: the gem exposes no deletion, so the created object
# has to be removed in the admin web afterwards.
GROMMUNIO_LIVE_MUTATE=1
GROMMUNIO_LIVE_SHARED_MAILBOX=info.test@example.test
